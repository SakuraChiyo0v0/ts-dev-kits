{
    "name": "ts-dev-kits",
    "version": "0.0.0",
    "private": true,
    "packageManager": "pnpm@11.15.1",
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "build": "pnpm -r --workspace-concurrency=1 build",
        "typecheck": "pnpm -r --if-present typecheck",
        "test": "pnpm -r --if-present --workspace-concurrency=4 test",
        "check": "pnpm test:guards && pnpm check:boundaries && pnpm build && pnpm typecheck && pnpm test && node scripts/check-cli-smoke.mjs && node scripts/check-skill-staleness.mjs && node scripts/check-package-index.mjs",
        "gen:structure": "node scripts/gen-repo-structure.mjs",
        "verify:email-package": "node scripts/verify-email-package.mjs",
        "verify:email-git-package": "node scripts/verify-email-git-package.mjs",
        "verify:lol-package": "node scripts/verify-lol-package.mjs",
        "verify:kazumi-package": "node scripts/verify-kazumi-package.mjs",
        "verify:published": "node scripts/verify-published-package.mjs",
        "check:boundaries": "node scripts/check-tool-boundaries.mjs",
        "test:guards": "node --test scripts/check-package-bumps.test.mjs scripts/release-tools.test.mjs scripts/package-groups.test.mjs",
        "verify:consumers": "node scripts/verify-published-package.mjs --representative",
        "verify:config-packages": "node scripts/verify-config-packages.mjs"
    },
    "devDependencies": {
        "@types/node": "^26.1.2",
        "@types/nodemailer": "^8.0.1",
        "@types/smtp-server": "^3.5.13",
        "semver": "7.8.5",
        "smtp-server": "^3.19.2",
        "tsx": "^4.23.5",
        "typescript": "^7.0.2",
        "vitest": "^4.1.10",
        "webdav-server": "^2.6.3"
    }
}
