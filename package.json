{
    "name":  "ts-dev-kits",
    "version":  "0.0.0",
    "private":  true,
    "packageManager":  "pnpm@11.15.1",
    "engines":  {
                    "node":  "\u003e=20"
                },
    "scripts":  {
                    "build":  "pnpm --filter @amechan/cli-utils build \u0026\u0026 pnpm --filter @amechan/email build \u0026\u0026 pnpm --filter @amechan/ffmpeg build \u0026\u0026 pnpm --filter @amechan/llm build \u0026\u0026 pnpm --filter @amechan/bilibili build \u0026\u0026 pnpm --filter @amechan/chat-platforms build",
                    "typecheck":  "pnpm -r --if-present typecheck",
                    "test":  "pnpm -r --if-present test",
                    "check":  "pnpm typecheck \u0026\u0026 pnpm test \u0026\u0026 pnpm build",
                    "verify:email-package":  "node scripts/verify-email-package.mjs",
                    "verify:email-git-package":  "node scripts/verify-email-git-package.mjs"
                },
    "devDependencies":  {
                            "@types/node":  "^26.1.2",
                            "@types/nodemailer":  "^8.0.1",
                            "@types/smtp-server":  "^3.5.13",
                            "smtp-server":  "^3.19.2",
                            "tsx":  "^4.23.5",
                            "typescript":  "^7.0.2",
                            "vitest":  "^4.1.10"
                        }
}
