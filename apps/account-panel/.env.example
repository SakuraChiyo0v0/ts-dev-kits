# 复制为 .env：本地 dev 由 process.loadEnvFile 自动加载；NAS 部署放到 /volume1/docker/account-panel/.env，由 compose ${VAR} 注入。
# 平台登录态 / 配置统一存 PostgreSQL（配置中心，无 WebDAV）。
PG_URL=postgres://<user>:<password>@<host>:5432/<db>
# 配置中心加密密钥：任意长随机串即可（64 位 hex 或 44 位 base64 会按原文使用，其余 sha256 派生）。
# 丢失后无法解密已保存的平台登录态，务必妥善备份。
CONFIG_KEY=please-change-to-a-long-random-string
# 下载 / 日志 / kazumi 规则根目录（容器内默认 /downloads；NAS 部署已由 compose 挂载 ./data）
DOWNLOAD_DIR=/downloads
# 服务端口（可选，默认 8787）
PORT=8787
# 容器内使用系统 chromium（可选；=1 时走 /usr/bin/chromium-browser，本地开发不需要）
USE_SYSTEM_CHROMIUM=1
