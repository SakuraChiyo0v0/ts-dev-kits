{
  "name": "@sakurachiyo0v0/vrchat",
  "version": "0.2.0",
  "description": "VRChat official REST API SDK (auth/users/worlds/avatars/instances/friends/notifications/favorites/groups/files/permissions/system/economy/moderation)",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "bin": {
    "amechan-vrchat": "./dist/cli/vrchat.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/clean.mjs && tsc --project tsconfig.bundle.json && rollup --config rollup.config.mjs && tsc --project tsconfig.build.json && tsc --project tsconfig.cli.json && node scripts/clean.mjs --intermediate-only",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@sakurachiyo0v0/account": "workspace:*",
    "@sakurachiyo0v0/cli-utils": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "rollup": "^4.62.4",
    "tslib": "^2.8.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
