{
  "name": "@sakurachiyo0v0/netease-music",
  "version": "0.5.0",
  "description": "NetEase Cloud Music download SDK: weapi encryption, QR-code login, privilege-aware quality selection and compliant downloading",
  "license": "UNLICENSED",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "bin": {
    "sc-netease": "./dist/cli/netease.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/clean.mjs && tsc --project tsconfig.bundle.json && rollup --config rollup.config.mjs && tsc --project tsconfig.build.json && tsc --project tsconfig.cli.json && node scripts/clean.mjs --intermediate-only",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@sakurachiyo0v0/account": "workspace:*",
    "@sakurachiyo0v0/cli-utils": "workspace:*",
    "@sakurachiyo0v0/config": "workspace:*",
    "@sakurachiyo0v0/ffmpeg": "workspace:*",
    "@sakurachiyo0v0/logger": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "rollup": "^4.62.4",
    "tslib": "^2.8.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "@sakurachiyo0v0/webdav": "workspace:*",
    "webdav-server": "^2.6.3"
  }
}
