{
  "name": "@sakurachiyo0v0/dsh-sdk-tools",
  "version": "0.5.3",
  "description": "DSH host plugin: expose ts-dev-kits SDK packages as agent tools via agent presets, with a Settings-page toggle for each package",
  "license": "UNLICENSED",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./client": {
      "types": "./lib/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "lib",
    "presets",
    "README.md"
  ],
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc --project tsconfig.bundle.json && rollup --config rollup.config.mjs && tsc --project tsconfig.build.json && tsc --project tsconfig.client.json && node scripts/clean.mjs --intermediate-only && tsdown",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "dependencies": {
    "@sakurachiyo0v0/bilibili": "workspace:*",
    "@sakurachiyo0v0/database": "workspace:*",
    "@sakurachiyo0v0/email": "workspace:*",
    "@sakurachiyo0v0/ffmpeg": "workspace:*",
    "@sakurachiyo0v0/kazumi": "workspace:*",
    "@sakurachiyo0v0/lol": "workspace:*",
    "@sakurachiyo0v0/logger": "workspace:*",
    "@sakurachiyo0v0/netease-music": "workspace:*",
    "@sakurachiyo0v0/vrchat": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1-rc.1",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.8",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1-rc.4",
    "@deepseek-ai/dsh-client-runtime": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-settings": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-settings-file": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1-rc.4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.1.2",
    "@types/react": "~18.3.1",
    "js-yaml": "^4.1.0",
    "lightningcss": "^1.32.0",
    "react": "^18.2.0",
    "rollup": "^4.62.4",
    "tsdown": "^0.22.14",
    "tslib": "^2.8.1",
    "typescript": "^7.0.2",
    "unrun": "^0.3.1",
    "vitest": "^4.1.10"
  }
}
