{
  "name": "@sakurachiyo0v0/webdav",
  "version": "0.3.0",
  "description": "WebDAV config storage SDK: basic file operations + atomic ConfigStore with backups, plus CLI",
  "license": "UNLICENSED",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "bin": {
    "sc-webdav": "./dist/cli/webdav.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/clean.mjs && tsc --project tsconfig.bundle.json && rollup --config rollup.config.mjs && tsc --project tsconfig.build.json && tsc --project tsconfig.cli.json && node scripts/clean.mjs --intermediate-only",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@sakurachiyo0v0/cli-utils": "workspace:*",
    "webdav": "^5.10.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "rollup": "^4.62.4",
    "tslib": "^2.8.1",
    "typescript": "^7.0.2",
    "webdav-server": "^2.6.3"
  }
}
