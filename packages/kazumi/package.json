{
  "name": "@sakurachiyo0v0/kazumi",
  "version": "0.2.1",
  "description": "Kazumi-rule-compatible anime scraping & download SDK: declarative rule engine (XPath + API modes) + m3u8 download merged to mp4 via ffmpeg",
  "license": "UNLICENSED",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "bin": {
    "sc-kazumi": "./dist/cli/kazumi.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/clean.mjs && tsc --project tsconfig.bundle.json && rollup --config rollup.config.mjs && tsc --project tsconfig.build.json && tsc --project tsconfig.cli.json && node scripts/clean.mjs --intermediate-only",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@sakurachiyo0v0/cli-utils": "workspace:*",
    "@sakurachiyo0v0/config": "workspace:*",
    "@sakurachiyo0v0/ffmpeg": "workspace:*",
    "@sakurachiyo0v0/logger": "workspace:*",
    "@xmldom/xmldom": "^0.9.8",
    "cheerio": "^1.0.0",
    "xpath": "^0.0.34"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "rollup": "^4.62.4",
    "tslib": "^2.8.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
